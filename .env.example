# Copy this file to `.env` and fill in real values. Never commit `.env`.

# LLM provider (Phase 3)
QANOUN_LLM_API_KEY=
QANOUN_LLM_FAST_MODEL=
QANOUN_LLM_STRONG_MODEL=

# Services (Phase 2)
QANOUN_QDRANT_URL=http://localhost:6333
QANOUN_QDRANT_COLLECTION=articles

# Embedding model (Phase 2). Lower the batch size if the PC runs out of memory.
QANOUN_EMBEDDING_MODEL=BAAI/bge-m3
QANOUN_EMBEDDING_MAX_TOKENS=1024
QANOUN_EMBEDDING_BATCH_SIZE=8
# sentence-transformers (full, 2.3 GB, torch) or onnx (8-bit, 568 MB, for an 8 GB laptop)
QANOUN_EMBEDDING_BACKEND=sentence-transformers
QANOUN_REDIS_URL=redis://localhost:6379/0
